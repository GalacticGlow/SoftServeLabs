{
  "datasets": [
    {
      "name": "product_count",
      "displayName": "Product count",
      "queryLines": [
        "SELECT COUNT(*) AS product_count FROM dim_products\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "brand_count",
      "displayName": "Brand count",
      "queryLines": [
        "SELECT COUNT(*) AS brand_count FROM dim_brands\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "nova_mix",
      "displayName": "Product mix by NOVA group",
      "queryLines": [
        "SELECT CASE WHEN nova_group BETWEEN 1 AND 4 THEN CAST(nova_group AS STRING) ELSE 'Unclassified' END AS nova_group, COUNT(*) AS product_count FROM dim_products GROUP BY 1 ORDER BY product_count DESC\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "top_brands",
      "displayName": "Top brands by products",
      "queryLines": [
        "SELECT b.brands_list, COUNT(DISTINCT f.product_id) AS product_count FROM fact_product_entries f JOIN dim_brands b ON f.brand_id = b.brand_id WHERE b.brands_list IS NOT NULL AND TRIM(b.brands_list) <> '' AND b.brands_list <> 'N/A' GROUP BY b.brands_list ORDER BY product_count DESC LIMIT 12\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "country_coverage",
      "displayName": "Products by country",
      "queryLines": [
        "SELECT country, COUNT(DISTINCT product_id) AS product_count FROM dim_products LATERAL VIEW EXPLODE(SPLIT(countries, ',')) country_rows AS country WHERE country IS NOT NULL AND TRIM(country) <> '' AND country <> 'N/A' GROUP BY country ORDER BY product_count DESC LIMIT 12\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "sugar_by_category",
      "displayName": "Average sugar by food category",
      "queryLines": [
        "SELECT pnns_groups_2 AS product_category, AVG(sugars_100g) AS avg_sugar_g, COUNT(*) AS product_count FROM dim_products WHERE pnns_groups_2 IS NOT NULL AND pnns_groups_2 <> 'N/A' AND sugars_100g IS NOT NULL GROUP BY pnns_groups_2 ORDER BY product_count DESC LIMIT 12\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    },
    {
      "name": "completeness_bands",
      "displayName": "Product data completeness",
      "queryLines": [
        "SELECT CASE WHEN try_cast(regexp_replace(product_data_completeness, '%', '') AS DOUBLE) >= 80 THEN '80-100%' WHEN try_cast(regexp_replace(product_data_completeness, '%', '') AS DOUBLE) >= 60 THEN '60-79%' WHEN try_cast(regexp_replace(product_data_completeness, '%', '') AS DOUBLE) >= 40 THEN '40-59%' WHEN try_cast(regexp_replace(product_data_completeness, '%', '') AS DOUBLE) >= 20 THEN '20-39%' ELSE '0-19%' END AS completeness_band, COUNT(*) AS product_count FROM fact_product_entries GROUP BY 1 ORDER BY MIN(COALESCE(try_cast(regexp_replace(product_data_completeness, '%', '') AS DOUBLE), 0))\n"
      ],
      "catalog": "dbr_dev_ua5816bd",
      "schema": "gulidov_artem_gold"
    }
  ],
