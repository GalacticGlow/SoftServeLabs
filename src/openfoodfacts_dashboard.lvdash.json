    {
      "name": "c5813028",
      "displayName": "Product Counts and Brand Insights Summary",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT f.product_id) AS total_products,\r\n",
        "    COUNT(DISTINCT CASE\r\n",
        "        WHEN b.brands_list <> 'N/A'\r\n",
        "        THEN f.brand_id\r\n",
        "    END) AS known_brands,\r\n",
        "\r\n",
        "    COUNT(DISTINCT CASE\r\n",
        "        WHEN p.environmental_score_grade <> 'N/A'\r\n",
        "        THEN f.product_id\r\n",
        "    END) AS products_with_environmental_grade,\r\n",
        "\r\n",
        "    COUNT(DISTINCT CASE\r\n",
        "        WHEN p.unique_scan_count > 0\r\n",
        "        THEN f.product_id\r\n",
        "    END) AS products_with_scans\r\n",
        "\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "LEFT JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "LEFT JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_brands b\r\n",
        "    ON f.brand_id = b.brand_id"
      ]
    },
    {
      "name": "8d127423",
      "displayName": "Top Brand Insights with Product Counts and Scan Averages",
      "queryLines": [
        "SELECT\r\n",
        "    b.brands_list,\r\n",
        "    COALESCE(\r\n",
        "        MAX(NULLIF(b.brand_owner, 'N/A')),\r\n",
        "        'N/A'\r\n",
        "    ) AS brand_owner,\r\n",
        "\r\n",
        "    COUNT(DISTINCT f.product_id) AS product_count,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        AVG(NULLIF(p.unique_scan_count, 0)),\r\n",
        "        1\r\n",
        "    ) AS avg_scans_per_product\r\n",
        "\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_brands b\r\n",
        "    ON f.brand_id = b.brand_id\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "WHERE b.brands_list <> 'N/A'\r\n",
        "\r\n",
        "GROUP BY b.brands_list\r\n",
        "\r\n",
        "ORDER BY product_count DESC\r\n",
        "\r\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ad631e79",
      "displayName": "Product Group Count Analysis",
      "queryLines": [
        "SELECT\r\n",
        "    p.nova_group,\r\n",
        "    COUNT(DISTINCT f.product_id) AS product_count\r\n",
        "\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "WHERE p.nova_group BETWEEN 1 AND 4\r\n",
        "\r\n",
        "GROUP BY p.nova_group\r\n",
        "\r\n",
        "ORDER BY p.nova_group"
      ]
    },
    {
      "name": "6e3ca860",
      "displayName": "Nutrient Averages and Product Counts by Food Groups",
      "queryLines": [
        "SELECT\r\n",
        "    p.pnns_groups_2,\r\n",
        "\r\n",
        "    COUNT(DISTINCT f.product_id) AS product_count,\r\n",
        "\r\n",
        "    ROUND(AVG(NULLIF(p.sugars_100g, 0)), 2)\r\n",
        "        AS avg_sugar_g,\r\n",
        "\r\n",
        "    ROUND(AVG(NULLIF(p.fat_100g, 0)), 2)\r\n",
        "        AS avg_fat_g,\r\n",
        "\r\n",
        "    ROUND(AVG(NULLIF(p.proteins_100g, 0)), 2)\r\n",
        "        AS avg_protein_g,\r\n",
        "\r\n",
        "    ROUND(AVG(NULLIF(p.energy_kcal_100g, 0)), 2)\r\n",
        "        AS avg_energy_kcal\r\n",
        "\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "WHERE p.pnns_groups_2 <> 'N/A'\r\n",
        "\r\n",
        "GROUP BY p.pnns_groups_2\r\n",
        "\r\n",
        "HAVING COUNT(DISTINCT f.product_id) >= 20\r\n",
        "\r\n",
        "ORDER BY product_count DESC"
      ]
    },
    {
      "name": "cbee819e",
      "displayName": "Environmental Grades and Product Metrics Summary",
      "queryLines": [
        "SELECT\r\n",
        "    p.environmental_score_grade AS environmental_grade,\r\n",
        "    COUNT(DISTINCT f.product_id) AS product_count,\r\n",
        "    ROUND(\r\n",
        "        AVG(NULLIF(p.environmental_score_score, 0)),\r\n",
        "        2\r\n",
        "    ) AS avg_environmental_score\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "WHERE p.environmental_score_grade <> 'N/A'\r\n",
        "\r\n",
        "GROUP BY p.environmental_score_grade\r\n",
        "\r\n",
        "ORDER BY product_count DESC"
      ]
    },
    {
      "name": "be2d5d53",
      "displayName": "Carbon Footprint Analysis of Food Products",
      "queryLines": [
        "SELECT\r\n",
        "    p.pnns_groups_2,\r\n",
        "    COUNT(DISTINCT f.product_id) AS measured_product_count,\r\n",
        "    ROUND(\r\n",
        "        AVG(NULLIF(p.carbon_footprint_100g, 0)),\r\n",
        "        2\r\n",
        "    ) AS avg_carbon_footprint\r\n",
        "\r\n",
        "FROM dbr_dev_ua5816bd.gulidov_artem_gold.fact_product_entries f\r\n",
        "\r\n",
        "JOIN dbr_dev_ua5816bd.gulidov_artem_gold.dim_products p\r\n",
        "    ON f.product_id = p.product_id\r\n",
        "\r\n",
        "WHERE p.pnns_groups_2 <> 'N/A'\r\n",
        "  AND p.carbon_footprint_100g > 0\r\n",
        "\r\n",
        "GROUP BY p.pnns_groups_2\r\n",
        "\r\n",
        "ORDER BY avg_carbon_footprint DESC"
      ]
    }
  ],
